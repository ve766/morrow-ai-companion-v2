{
  "version": "stage-4a-cat-name-v2",
  "story": "User authorizes a fact, recalls it in a new session, corrects it with a pronoun, reads the corrected value, then asks about the historical value. The correction must be committed before the reply.",
  "sessions": [
    {
      "id": "A",
      "user": "我有一只猫，它叫咪咪。帮我记住。",
      "expectPreResponseOperation": "create",
      "expectOperationBlock": {
        "operation": "create",
        "status": "committed_and_verified",
        "currentValue": "咪咪"
      }
    },
    {
      "id": "B",
      "user": "你还记得我的猫叫什么吗？",
      "expectEvidenceValue": "咪咪"
    },
    {
      "id": "C",
      "user": "我说错了，它现在叫豆豆。帮我更新。",
      "expectPreResponseOperation": "correct",
      "expectOperationBlock": {
        "operation": "correct",
        "status": "committed_and_verified",
        "previousValue": "咪咪",
        "currentValue": "豆豆"
      },
      "correctionUnderstanding": {
        "newValue": "豆豆",
        "oldValue": "咪咪"
      }
    },
    {
      "id": "D",
      "user": "我的猫现在叫什么？",
      "expectEvidenceValue": "豆豆",
      "mustNotBeCurrent": "咪咪"
    },
    {
      "id": "E",
      "user": "它之前叫什么？",
      "historyQuestion": {
        "oldValue": "咪咪",
        "currentValue": "豆豆"
      },
      "sameConversationAs": "D"
    }
  ],
  "edgeCases": [
    {
      "id": "X1",
      "kind": "ambiguous_pronoun",
      "setup": [
        "我有一只猫叫咪咪。帮我记住。",
        "我还有一只猫叫小黑。帮我记住。"
      ],
      "turn": "我说错了，它现在叫豆豆。帮我更新。",
      "expectOperation": "clarify"
    },
    {
      "id": "X2",
      "kind": "retracted_not_injected",
      "setup": [
        "我的护照放在书房。帮我记住。"
      ],
      "retract": true,
      "turn": "我的护照放在哪里？",
      "expectNoEvidence": "书房"
    },
    {
      "id": "X3",
      "kind": "idempotent_replay",
      "turn": "我住在杭州。帮我记住。",
      "replay": 3,
      "expectActiveCount": 1
    }
  ]
}
