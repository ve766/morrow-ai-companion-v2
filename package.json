{
  "name": "morrow-ai-companion-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Local-first AI companion with a traceable cognitive loop",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "evaluate": "node scripts/run-evaluation.mjs",
    "evaluate:cognition": "node scripts/run-cognitive-core-evaluation.mjs",
    "verify": "npm run typecheck && npm test && npm run evaluate && npm run evaluate:cognition && npm run build && npm run smoke",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "verify:phase23": "node node_modules/esbuild/bin/esbuild scripts/verify-phase23-report.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-phase23.cjs --log-level=warning && node node_modules/.cache/verify-phase23.cjs",
    "eval:stage2": "node node_modules/esbuild/bin/esbuild evals/stage-2/runner/cli.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/stage2-eval.cjs --log-level=warning && node node_modules/.cache/stage2-eval.cjs",
    "eval:ablation": "node node_modules/esbuild/bin/esbuild evals/stage-2/ablation/run.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/stage2-ablation.cjs --log-level=warning && node node_modules/.cache/stage2-ablation.cjs",
    "eval:stage3": "node node_modules/esbuild/bin/esbuild evals/stage-3/runner/cli.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/stage3-eval.cjs --log-level=warning && node node_modules/.cache/stage3-eval.cjs",
    "eval:stage3:ablation": "node node_modules/esbuild/bin/esbuild evals/stage-3/ablation/run.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/stage3-ablation.cjs --log-level=warning && node node_modules/.cache/stage3-ablation.cjs",
    "eval:stage3:longitudinal": "node node_modules/esbuild/bin/esbuild evals/stage-3/longitudinal/run.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/stage3-longitudinal.cjs --log-level=warning && node node_modules/.cache/stage3-longitudinal.cjs",
    "eval:stage3:restart": "node node_modules/esbuild/bin/esbuild evals/stage-3/restart/run.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/stage3-restart.cjs --log-level=warning && node node_modules/.cache/stage3-restart.cjs",
    "eval:stage3:long-conversation": "node node_modules/esbuild/bin/esbuild evals/stage-3/long-conversation/run.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/stage3-longconv.cjs --log-level=warning && node node_modules/.cache/stage3-longconv.cjs",
    "eval:topic-identity": "node node_modules/esbuild/bin/esbuild evals/stage-2/topic-identity-metrics.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/topic-identity.cjs --log-level=warning && node node_modules/.cache/topic-identity.cjs",
    "eval:stage3:live": "node node_modules/esbuild/bin/esbuild evals/stage-3/live/run.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/stage3-live.cjs --log-level=warning && node node_modules/.cache/stage3-live.cjs",
    "eval:final-closure:live": "node node_modules/esbuild/bin/esbuild evals/real-provider/final-closure-live/run.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/closure-live.cjs --log-level=warning && node node_modules/.cache/closure-live.cjs",
    "eval:stage3:final-closure": "node node_modules/esbuild/bin/esbuild evals/stage-3/final-closure/run.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/stage3-closure.cjs --log-level=warning && node node_modules/.cache/stage3-closure.cjs",
    "eval:stage3:memory": "node node_modules/esbuild/bin/esbuild evals/stage-3/memory-recall/run.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/stage3-memory.cjs --log-level=warning && node node_modules/.cache/stage3-memory.cjs",
    "eval:stage3:intent": "node node_modules/esbuild/bin/esbuild evals/stage-3/intent-understanding/run.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/c1-intent.cjs --log-level=warning && node node_modules/.cache/c1-intent.cjs",
    "eval:stage3:intent:semantic": "node node_modules/esbuild/bin/esbuild evals/stage-3/intent-understanding/semantic.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/c1-intent-semantic.cjs --log-level=warning && node node_modules/.cache/c1-intent-semantic.cjs"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "3.1.0",
    "esbuild": "0.25.12",
    "typescript": "5.8.3",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "com.morrow.ai-companion",
    "productName": "Morrow",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Morrow-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
