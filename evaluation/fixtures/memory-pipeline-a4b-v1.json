     "expect": {
      "memoryEntriesAtMost": 1
     }
    },
    {
     "content": "晚上想早点睡。",
     "expect": {
      "memoryEntriesAtMost": 1
     }
    },
    {
     "content": "我把书桌整理了一下。",
     "expect": {
      "memoryEntriesAtMost": 1
     }
    },
    {
     "content": "窗外在下雨。",
     "expect": {
      "memoryEntriesAtMost": 1
     }
    },
    {
     "content": "我搬家了，现在住在大阪。",
     "op": {
      "type": "correct",
      "memoryIndex": 0,
      "content": "我住在大阪。"
     },
     "expect": {
      "contextContains": [
       "大阪"
      ],
      "contextExcludes": [
       "杭州"
      ]
     }
    },
    {
     "content": "我现在住在哪里？",
     "expect": {
      "contextContains": [
       "大阪"
      ],
      "contextExcludes": [
       "杭州"
      ]
     }
    }
   ],
   "realModel": {
    "check": "substring",
    "mustMention": [
     "大阪"
    ],
    "mustNotMention": [
     "杭州"
    ],
    "judge": {
     "current": [
      "大阪"
     ],
     "superseded": [
      "杭州"
     ],
     "expectsAnswer": true,
     "valueRelations": {
      "大阪": [
       "住"
      ],
      "杭州": [
       "住"
      ]
     }
    }
   }
  },
  {
   "id": "a4-sensitive-boundary",
   "capability": "B11_sensitive_ceiling_not_delivered",
   "title": "A sensitive memory stays out of the request and the reply",
   "claims": "The allergy fact is above the default ceiling, so it must not be delivered and must not be mentioned.",
   "setup": {
    "memories": [
     {
      "content": "我对花生严重过敏。",
      "sensitivity": "sensitive"
     },
     {
      "content": "我住在杭州。",
      "sensitivity": "personal"
     }
    ]
   },
   "turns": [
    {
     "content": "我中午吃什么好？",
     "expect": {
      "memoryEntries": 0,
      "contextExcludes": [
       "花生"
      ]
     }
    }
   ],
   "realModel": {
    "check": "substring",
    "mustNotMention": [
     "花生"
    ],
    "judge": {
     "expectsAnswer": true
    }
   }
  }
 ]
}