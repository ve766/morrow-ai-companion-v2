      "maximumSensitivity": "personal",
      "memories": [
        { "id": "blender", "content": "我最近开始学习 Blender。", "sensitivity": "personal" },
        { "id": "hangzhou", "content": "我一直住在杭州。", "sensitivity": "personal" },
        { "id": "cat", "content": "我养了一只猫。", "sensitivity": "personal" }
      ],
      "relevant": ["blender"],
      "note": "Only the conversation-context evidence may retrieve Blender."
    },
    {
      "id": "conflict-both-relevant",
      "query": "我住在哪里？",
      "maximumSensitivity": "personal",
      "memories": [
        { "id": "hangzhou", "content": "我住在杭州。", "sensitivity": "personal" },
        { "id": "osaka", "content": "我住在大阪。", "sensitivity": "personal" }
      ],
      "relevant": ["hangzhou", "osaka"],
      "note": "A conflict must not be silently resolved by ordering."
    },
    {
      "id": "retracted-excluded",
      "query": "我的项目代号是什么？",
