        { "id": "blender", "content": "我最近开始学习 Blender。", "sensitivity": "personal" },
        { "id": "cat", "content": "我养了一只猫。", "sensitivity": "personal" }
      ],
      "relevant": ["hangzhou"],
      "note": "Residence cue plus 住在/杭州 evidence."
    },
    {
      "id": "preference-paraphrase",
      "query": "你记得我喜欢怎样做决定吗？",
      "maximumSensitivity": "personal",
      "memories": [
        { "id": "preference", "content": "我喜欢独自研究新技术，不喜欢别人替我做决定。", "sensitivity": "personal" },
        { "id": "hangzhou", "content": "我一直住在杭州。", "sensitivity": "personal" }
      ],
      "relevant": ["preference"]
    },
    {
      "id": "learning-paraphrase",
      "query": "我最近在学什么软件？",
      "maximumSensitivity": "personal",
      "memories": [
        { "id": "blender", "content": "我最近开始学习 Blender。", "sensitivity": "personal" },
        { "id": "hangzhou", "content": "我一直住在杭州。", "sensitivity": "personal" }
