{
  "schemaVersion": 1,
  "id": "retrieval-context-v2",
  "description": "Chinese false-recall and relevance gates added after the memory-pipeline diagnosis. Continuity is not counted as a retrieval hit.",
  "cases": [
    {
      "id": "unrelated-chinese-bigram-trap",
      "query": "给我一个完全无关的问题。",
      "maximumSensitivity": "personal",
      "memories": [
        { "id": "hangzhou", "content": "我一直住在杭州。", "sensitivity": "personal" },
        { "id": "blender", "content": "我最近开始学习 Blender。", "sensitivity": "personal" },
        { "id": "preference", "content": "我喜欢独自研究新技术，不喜欢别人替我做决定。", "sensitivity": "personal" }
      ],
      "relevant": [],
      "note": "The old CJK bigram rule matched 我一直住在杭州 only through the accidental bigram 我一."
    },
    {
      "id": "residence-paraphrase",
      "query": "我现在住在哪里？",
      "maximumSensitivity": "personal",
      "memories": [
